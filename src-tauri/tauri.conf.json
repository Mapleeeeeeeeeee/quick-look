{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "copilot-preview",
  "version": "0.1.0",
  "identifier": "com.copilot-preview.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "File Preview",
        "width": 900,
        "height": 650,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true,
          "required": false
        },
        {
          "name": "start-line",
          "takesValue": true,
          "required": false
        },
        {
          "name": "end-line",
          "takesValue": true,
          "required": false
        }
      ]
    }
  }
}
